{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0*"
        },
        {
          "url": "http://localhost:5042"
        }
      ]
    }
  ],
  "remote": {
    "urls": [
      "http://localhost:5042",
      "https://localhost:7135"
    ]
  }
}
