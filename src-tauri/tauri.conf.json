{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fp-rail",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../src-frontend/dist/src-frontend/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": {
      "script": "pnpm --filter src-frontend start",
      "wait": false
    },
    "beforeBuildCommand": "pnpm --filter src-frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "FP Rail CAD",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: http://localhost:4200; connect-src 'self' ipc: http://ipc.localhost http://localhost:5042 https://localhost:7135 https://tiles.openfreemap.org https://openfreemap.org https://maputnik.github.io; worker-src 'self' blob:; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/FpRail.WebApi"
    ]
  }
}
